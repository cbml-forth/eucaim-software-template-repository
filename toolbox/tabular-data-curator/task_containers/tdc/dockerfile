# Python base image
FROM python:3.9-slim

# Maintainer information
LABEL maintainer="bpezoulas@gmail.com"
LABEL version="1.0"
LABEL description="TDC (Tabular Data Curation) - data quality evaluation, curation and similarity detection for tabular datasets"
LABEL image.version="1.0"
LABEL image.source="https://github.com/vpz4/TDC"

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Set defaults for build arguments
ARG USER_UID=1000
ARG USER_GID=1000

# Create non-root user and group, and prevent login
RUN groupadd -g $USER_GID eucaim && \
    useradd -r -u $USER_UID -g eucaim -d /home/eucaim -m -s /usr/sbin/nologin eucaim

# Install system dependencies required to build the Python scientific stack
RUN apt-get update && \
    apt-get install -y --no-install-recommends gosu \
    build-essential g++ gcc make \
    libfftw3-dev libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory (placeholder, overridden at runtime)
WORKDIR /app

# Install Python dependencies first to maximize Docker layer caching
COPY ./app/requirements.txt .
# setuptools<81 keeps pkg_resources available, which Orange3 imports at runtime
RUN python -m pip install --upgrade pip "setuptools<81" wheel \
 && pip install --no-cache-dir cython numpy \
 && pip install --no-cache-dir -r requirements.txt

# Copy the application source code
COPY ./app/ /app/
COPY ./entrypoint.sh /app/entrypoint.sh

# Ensure default input/output directories exist
RUN mkdir -p /app/input_data /app/output_data

# Set any necessary executable permissions for non-root user
RUN chown -R root:root /app && chmod 755 /app/main.py /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]

CMD ["python3", "main.py", "-i", "/app/input_data", "-o", "/app/output_data"]
