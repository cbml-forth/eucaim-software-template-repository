# Python base image
FROM python:3.9-slim

# Maintainer information
LABEL maintainer="bpezoulas@gmail.com"
LABEL version="1.2"
LABEL description="TDC (Tabular Data Curation) - data quality evaluation, curation and similarity detection for tabular datasets"
LABEL image.version="1.2"
LABEL image.source="https://github.com/vpz4/TDC"

# All runtime setup is done through ENV (no entrypoint script): the FEM replaces the ENTRYPOINT,
# and the runtime user is set by whoever starts the container (FEM, Jobman or by hand), so HOME
# and the matplotlib cache point to /tmp, which any UID can write to.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib

# Install system dependencies required to build the Python scientific stack
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential g++ gcc make \
    libfftw3-dev libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first to maximize Docker layer caching
COPY ./app/requirements.txt .
# setuptools<81 keeps pkg_resources available, which Orange3 imports at runtime
RUN python -m pip install --upgrade pip "setuptools<81" wheel \
 && pip install --no-cache-dir cython numpy \
 && pip install --no-cache-dir -r requirements.txt

# Copy the application source code (read-only for the runtime user; reports go to -o)
COPY ./app/main.py ./app/requirements.txt /app/
RUN chmod 755 /app/main.py

# Base command as exec-form ENTRYPOINT, no CMD. The CWL baseCommand is exactly the same:
# baseCommand: [python3, /app/main.py]
ENTRYPOINT ["python3", "/app/main.py"]
